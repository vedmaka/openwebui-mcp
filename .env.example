# Open WebUI connection (required)
OPENWEBUI_BASE_URL=http://localhost:8080
OPENWEBUI_API_KEY=sk-...

# Optional: default model used by `ask` when one is not passed, e.g. a model
# id returned by list_models (must be the model id, not the model name)
# OPENWEBUI_DEFAULT_MODEL=sample-workspace-model-1

# Optional: force every `ask` call to use OPENWEBUI_DEFAULT_MODEL, ignoring
# whatever model the client asks for (true | false)
# OPENWEBUI_ENFORCE_DEFAULT_MODEL=false

# Optional: custom first line of the `ask` tool description, shown to MCP
# agents. Replaces just the summary line ("Ask an Open WebUI model a question,
# with tool support."); the IMPORTANT/stateless/history/args guidance is always
# kept. Unset keeps the default summary
# OPENWEBUI_ASK_DESCRIPTION="Ask a model, with tool support"

# Optional: server-wide MCP `instructions`, read by Codex and other hosts on
# initialize. Best place to tell agents to use the tools proactively, e.g.
# OPENWEBUI_INSTRUCTIONS="Use ask() first for any question; the remote
# model handles knowledge-base and wiki search via its own tools"

# Optional: require a token on the MCP endpoint itself. Clients can use a
# Bearer header or /mcp?apiKey=change-me (the header is safer when supported)
# OPENWEBUI_MCP_TOKEN=change-me

# Optional: transport (stdio | sse | streamable-http)
# OPENWEBUI_MCP_TRANSPORT=stdio

# Optional: chat timeout in ms
# OWUI_TIMEOUT_MS=120000

# TLS to Open WebUI over https. If the server uses a self-signed / private-CA
# cert (or your env's MITM proxy CA), trust it explicitly instead of
# disabling verification:
# OPENWEBUI_CA_BUNDLE=/path/to/ca.pem
# Or, to skip certificate verification entirely (JSON routes; not recommended):
# OPENWEBUI_SSL_VERIFY=false
